# ─────────────────────────────────────────────────────────────
#  bpofinanceiro — variáveis de ambiente
#  Copie para .env e preencha. NUNCA commite o .env.
#  Em produção (NODE_ENV=production) o server aborta se
#  JWT_SECRET ou ENCRYPTION_KEY estiverem ausentes/ inválidos.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# ── Banco ──────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/bpo
# true = TLS com rejectUnauthorized:false; qualquer outra coisa = sem TLS
DB_SSL=false

# ── Segredos (OBRIGATÓRIOS em produção) ────────────────────
# 64 caracteres hex. Gere com:  openssl rand -hex 32
JWT_SECRET=
# 64 caracteres hex. DEVE ser diferente do JWT_SECRET. Gere com: openssl rand -hex 32
# Cifra CNPJ / razão social / telefone em repouso. Se mudar, os dados
# já gravados ficam ilegíveis — trate como chave permanente.
ENCRYPTION_KEY=

# ── Admin (conta única do contador) ───────────────────────
MAIL_ADMIN=admin@exemplo.com.br
# Use um valor forte e EXCLUSIVO (não reaproveite a senha de e-mail)
PASSWORD_ADMIN=

# ── E-mail (SMTP) ─────────────────────────────────────────
MAIL_SERVER=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=contato@exemplo.com.br
MAIL_PASSWORD=
MAIL_FROM_NAME=Cadastro | Vírgula Contábil
MAIL_FROM_ADDRESS=cadastro@exemplo.com.br

# ── CORS ──────────────────────────────────────────────────
# Origens permitidas, separadas por vírgula. Vazio em produção = só same-origin.
CORS_ORIGINS=https://financeiro.virgulacontabil.com.br

# ── URL pública ───────────────────────────────────────────
# Usada para montar os links dos e-mails (ativar conta, redefinir senha).
# Se vazio, cai para o primeiro item de CORS_ORIGINS. NUNCA confie no header Host.
APP_URL=https://financeiro.virgulacontabil.com.br
